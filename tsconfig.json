{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "baseUrl": ".",
    "paths": {
      "@core/*": [
        "core/src/*"
      ],
      "@adapters/*": [
        "adapters/src/*"
      ],
      "@app/*": [
        "app/src/*"
      ],
      "@contracts/*": [
        "contracts/*"
      ]
    }
  },
  "include": [
    "core/src/**/*.ts",
    "adapters/src/**/*.ts",
    "app/src/**/*.ts",
    "edge/src/**/*.ts",
    "ops/*.ts"
  ]
}
